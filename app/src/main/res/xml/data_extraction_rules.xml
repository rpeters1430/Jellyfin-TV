<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!--
      jellyfin_tv_prefs holds the Jellyfin session token/userId in plaintext (SharedPreferences
      isn't encrypted). Exclude it from cloud backup and device-to-device transfer so the token
      can't be extracted via a restored backup on another device.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="jellyfin_tv_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jellyfin_tv_prefs.xml" />
    </device-transfer>
</data-extraction-rules>